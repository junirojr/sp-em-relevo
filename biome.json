{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!data",
      "!dist",
      "!scripts/data/raw",
      "!test-results",
      "!playwright-report",
      "!node_modules",
      "!.claude",
      "!.agents",
      "!.codex",
      "!scripts/dev/fixtures"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  }
}
