{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src/domain/**/*.js"],
  "exclude": ["legacy", "node_modules", "src/domain/**/*.test.js"]
}
